{
  "name": "party-manager",
  "private": true,
  "version": "1.0.0",
  "description": "D&D 5e homebrew party manager — desktop app",
  "author": "TheIllusionary",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:local": "cross-env VITE_API_URL=/api vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev:local\" \"wait-on tcp:5173 && electron .\"",
    "build:api-deps": "npm install --prefix ../api --omit=dev",
    "electron:build": "npm run build:api-deps && vite build && electron-builder --win --publish never",
    "electron:publish": "npm run build:api-deps && vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.rpgpartymanager.app",
    "productName": "Party Manager",
    "copyright": "Copyright © 2026 RPG Party Manager",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../api",
        "to": "api",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.git/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PartyManager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TheIllusionary",
        "repo": "RPG-Party-Manager",
        "releaseType": "release"
      }
    ]
  }
}
