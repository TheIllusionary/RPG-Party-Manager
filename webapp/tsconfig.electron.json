{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "outDir": "electron/lib",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/types/domain/**/*",
    "src/types/player-view.ts",
    "src/engine/**/*",
    "src/services/persistence/**/*",
    "src/services/homebrew/**/*",
    "src/services/PlayerViewService.ts",
    "src/services/WebSocketServer.ts",
    "src/services/actorPersistence.ts",
    "src/types/sync.ts",
    "src/electron-main/**/*",
    "src/features/dashboard/constants/**/*"
  ]
}
