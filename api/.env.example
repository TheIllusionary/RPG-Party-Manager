# Required for local API (api/.env is gitignored — never commit secrets)
# MONGO_URI=mongodb://127.0.0.1:27017/rpg_party_manager
# PORT=3001
# JWT_SECRET=change-me-to-a-long-random-string

# Production: set MONGO_URI and JWT_SECRET in Render Dashboard → Environment

# Master Compendium seed (webapp: npm run seed:master-compendium --prefix webapp)
# FIVEETOOLS_SPELLS_DIR=../vendor/5etools-src/data/spells
